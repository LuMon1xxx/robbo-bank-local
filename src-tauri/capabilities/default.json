{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "sql:default",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "updater:default",
    "process:default"
  ]
}
