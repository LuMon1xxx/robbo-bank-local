{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RobboBank",
  "version": "0.1.3",
  "identifier": "ru.robbo.bank.local",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "РоббоБанк",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "startMenuFolder": "Мир Робот",
        "languages": ["Russian", "English"],
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyM0ZGMzJBM0NGN0YwMQpSV1FCZjgrak12OGpETzJSSGhEcUtXeEZQdkZCdHdJTjdKb2VIMUZWTHYxdTM0dGxvRXBNaEZKNAo=",
      "endpoints": [
        "https://github.com/LuMon1xxx/robbo-bank-local/releases/latest/download/latest.json"
      ]
    }
  }
}
